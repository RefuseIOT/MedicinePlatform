@startuml 处方模块用例图
left to right direction
skinparam packageStyle rectangle

actor "医生" as D
actor "药师" as PH
actor "患者" as P
actor "管理员" as A

rectangle "处方模块" {
  usecase "UC-03 药品目录维护" as UC03
  usecase "UC-09 开具处方" as UC09
  usecase "UC-10 提交处方审核" as UC10
  usecase "UC-11 审核处方通过" as UC11
  usecase "UC-12 驳回处方" as UC12
  usecase "UC-13 修改并重提处方" as UC13
  usecase "UC-14 核销处方" as UC14
  usecase "UC-16 查看处方与状态" as UC16
}

D --> UC09
D --> UC10
D --> UC13
D --> UC16

PH --> UC03
PH --> UC11
PH --> UC12
PH --> UC14
PH --> UC16

P --> UC16

A --> UC16

UC10 ..> UC09 : <<include>>
UC13 ..> UC12 : <<extend>>
@enduml
